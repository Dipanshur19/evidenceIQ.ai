# Copy this file to .env and fill in your Gemini API key to enable
# grounded LLM narration (Part 14). Get a key at https://aistudio.google.com/apikey
#
# Without a key, EvidenceIQ.ai automatically falls back to a deterministic,
# rule-based narrative generator (app/llm_narration.py) so the full pipeline
# still runs end-to-end offline.
GEMINI_API_KEY=your_gemini_api_key_here

# NOTE: "gemini 3.6 flash" is not a published Google model name at the time
# this project was built. GEMINI_MODEL defaults to the current fast Gemini
# model and is fully configurable here without touching any code -- point it
# at whichever Gemini Flash version is live on your account (e.g.
# gemini-2.0-flash, gemini-2.5-flash, or a future release).
GEMINI_MODEL=gemini-2.0-flash
